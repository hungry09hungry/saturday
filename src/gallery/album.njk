---
pagination:
  data: albums.pages
  size: 1
  alias: pg
permalink: "/gallery/{{ pg.slug }}/{% if pg.n > 1 %}{{ pg.n }}/{% endif %}index.html"
layout: underwater-duck.njk
stylesheet: "/resource/style/gallery.css"
---
  <header>
    <a href="/gallery/index.html">← all albums</a>
    <h1>{{ pg.title }}</h1>
    {% if pg.desc %}<p>{{ pg.desc }}</p>{% endif %}
  </header>


    <ul class="photos">
      {% for p in pg.photos %}
        <li>
          <a href="{{ p.url }}" data-desc="{{ p.desc }}">
            <img src="{{ p.url }}" width="300" alt="{{ p.desc }}" loading="lazy">
          </a>
        </li>
      {% endfor %}
    </ul>


    {% if pg.n > 1 %}<a href="/gallery/{{ pg.slug | urlencode }}/{% if pg.n > 2 %}{{ pg.n - 1 }}/{% endif %}">prev</a>{% endif %}
    <span>page {{ pg.n }} of {{ pg.total }}</span>
    {% if pg.n < pg.total %}<a href="/gallery/{{ pg.slug | urlencode }}/{{ pg.n + 1 }}/">next</a>{% endif %}

  <dialog id="viewer">
    <img alt="">
    <p></p>
    <div id="closebtn">&#8855;</div>
  </dialog>

<script>
  const viewer = document.getElementById("viewer");
  const viewerImg = viewer.querySelector("img");
  const viewerDesc = viewer.querySelector("p");

  document.querySelectorAll(".photos a").forEach(a => {
    a.addEventListener("click", e => {
      e.preventDefault();

      const desc = a.dataset.desc;
      viewerImg.src = a.href;
      viewerImg.alt = desc || "";
      viewerDesc.textContent = desc || "";
      viewerDesc.hidden = !desc;

      viewer.showModal();
    });
  });

  viewer.addEventListener("click", () => viewer.close());
</script>
</body>
</html>